#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/compose.yaml"

start() {
  podman compose -f "$COMPOSE_FILE" pull
  podman compose -f "$COMPOSE_FILE" up -d
  tailscale up
  tailscale serve --https=443 --bg localhost:3005
  happier daemon start
}

stop() {
  tailscale serve --https=443 off
  podman compose -f "$COMPOSE_FILE" down
  happier daemon stop
  tailscale down
}

case "${1:-}" in
  start) start ;;
  stop)  stop ;;
  *)
    echo "Usage: hp {start|stop}" >&2
    exit 1
    ;;
esac
